#!/usr/bin/env sh
set -eu

usage() {
  cat <<'USAGE'
Usage: scripts/demo/admin-ui [--project NAME] <command> [options]

Simple maintainer commands for the Lockspire adoption demo admin UI.

Commands:
  up       Start the demo detached, wait for readiness, and print URLs.
  info     Reprint URLs, accounts, and next commands for a running demo.
  smoke    Run the adoption demo smoke against the running demo URL.
  logs     Follow the demo web logs.
  stop     Stop containers and preserve volumes.
  reset    Reset the database volume by default.
  cleanup  Preview scoped cleanup, or pass --execute to remove listed resources.
  status   List active demo containers.

Examples:
  scripts/demo/admin-ui up
  scripts/demo/admin-ui smoke
  scripts/demo/admin-ui stop
USAGE
}

project="${COMPOSE_PROJECT_NAME:-lockspire-adoption-demo}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --project)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for --project" >&2
        usage >&2
        exit 1
      fi
      project="$2"
      export COMPOSE_PROJECT_NAME="$project"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

command="${1:-help}"
if [ "$#" -gt 0 ]; then
  shift
fi

if ! command -v git >/dev/null 2>&1; then
  echo "git is required to locate the Lockspire repo root" >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

compose() {
  docker compose --project-name "$project" -f examples/adoption_demo/docker-compose.yml "$@"
}

demo_base_url() {
  url="$(compose exec -T web sh -lc 'printf "%s" "${LOCKSPIRE_DEMO_BASE_URL:-http://lockspire-demo.localhost}"' 2>/dev/null || true)"

  if [ -z "$url" ]; then
    url="${LOCKSPIRE_DEMO_BASE_URL:-http://lockspire-demo.localhost}"
  fi

  printf '%s' "${url%/}"
}

case "$command" in
  up)
    examples/adoption_demo/bin/docker-up --project "$project" --detach "$@"
    ;;
  info)
    compose exec -T web ./bin/docker-info
    ;;
  smoke)
    base_url="$(demo_base_url)"
    LOCKSPIRE_DEMO_BASE_URL="$base_url" scripts/demo/adoption_smoke.sh
    ;;
  logs)
    compose logs -f web
    ;;
  stop)
    examples/adoption_demo/bin/docker-stop --project "$project"
    ;;
  reset)
    if [ "$#" -eq 0 ]; then
      examples/adoption_demo/bin/docker-reset --project "$project" --db-only
    else
      examples/adoption_demo/bin/docker-reset --project "$project" "$@"
    fi
    ;;
  cleanup)
    examples/adoption_demo/bin/docker-cleanup --project "$project" "$@"
    ;;
  status)
    docker container ls --all --filter "label=com.docker.compose.project=${project}" \
      --format 'table {{.Names}}\t{{.Status}}\t{{.Ports}}'
    ;;
  help | -h | --help)
    usage
    ;;
  *)
    echo "Unknown command: ${command}" >&2
    usage >&2
    exit 1
    ;;
esac
