<Lockspire.Web.Live.AdminLayoutLive.shell current_section={@current_section} page_title={@page_title}>
  <%= if @policy_state == :unavailable do %>
    <Lockspire.Web.Components.AdminComponents.alert
      variant={:danger}
      title="Could not load app registration settings"
    >
      <p>Lockspire could not confirm the saved settings. No registration mode is assumed.</p>
      <Lockspire.Web.Components.AdminComponents.action_bar>
        <Lockspire.Web.Components.AdminComponents.admin_button
          type="button"
          phx-click="reload_policy"
          variant={:primary}
        >
          Reload settings
        </Lockspire.Web.Components.AdminComponents.admin_button>
      </Lockspire.Web.Components.AdminComponents.action_bar>
    </Lockspire.Web.Components.AdminComponents.alert>
  <% else %>
    <Lockspire.Web.Components.AdminComponents.policy_nav current={:dcr} />

      <Lockspire.Web.Components.AdminComponents.error_summary
        :if={@show_error_summary and @form_errors != []}
        title="Review app registration settings"
        errors={@form_errors}
      />

      <p :if={@save_notice} role="status" class="lockspire-admin-alert lockspire-admin-alert-info">
        {@save_notice}
      </p>

      <form
        id="dcr-policy-form"
        class="lockspire-admin-form-stack lockspire-admin-registration-settings"
        phx-change={Phoenix.LiveView.JS.push("preview_policy", page_loading: true)}
        phx-debounce="500"
        phx-submit={Phoenix.LiveView.JS.push("save_policy", page_loading: true)}
      >
        <Lockspire.Web.Components.AdminComponents.workflow_shell
          title="Who can register"
        >
          <Lockspire.Web.Components.AdminComponents.radio_group
            id="registration_policy"
            name="policy[registration_policy]"
            label="Registration access"
            value={@form[:registration_policy].value}
            errors={field_errors(@form_errors, :registration_policy)}
          >
            <:option value="disabled" label="Disabled" help="Apps cannot register themselves." />
            <:option value="initial_access_token" label="App setup token required" help="Apps need a one-time setup token to register." />
            <:option value="open" label="Open" help="Apps can register without a setup token, within the configured limits." />

          </Lockspire.Web.Components.AdminComponents.radio_group>
        </Lockspire.Web.Components.AdminComponents.workflow_shell>

        <Lockspire.Web.Components.AdminComponents.workflow_shell
          title="What apps may request"
        >
          <Lockspire.Web.Components.AdminComponents.form_field
            id="dcr_allowed_scopes"
            label="Allowed permissions (OAuth scopes)"
            help="Permissions an app may request."
            errors={field_errors(@form_errors, :dcr_allowed_scopes)}
          >
            <Lockspire.Web.Components.AdminComponents.multi_value_control
              id="dcr_allowed_scopes"
              name="policy[dcr_allowed_scopes]"
              value={@form[:dcr_allowed_scopes].value}
              suggestions={["openid", "profile", "email", "phone", "address", "offline_access"]}
              errors={field_errors(@form_errors, :dcr_allowed_scopes)}
            />
          </Lockspire.Web.Components.AdminComponents.form_field>

          <Lockspire.Web.Components.AdminComponents.checkbox_group
            id="dcr_allowed_grant_types" name="policy[dcr_allowed_grant_types]"
            label="Allowed OAuth flows" help="OAuth flows an app may use."
            value={@form[:dcr_allowed_grant_types].value} choices={[{"authorization_code", "Authorization code"}, {"refresh_token", "Refresh token"}, {"urn:ietf:params:oauth:grant-type:device_code", "Device sign-in"}, {"urn:ietf:params:oauth:grant-type:token-exchange", "Token exchange"}]}
            errors={field_errors(@form_errors, :dcr_allowed_grant_types)} />


          <Lockspire.Web.Components.AdminComponents.checkbox_group
            id="dcr_allowed_response_types" name="policy[dcr_allowed_response_types]"
            label="Allowed sign-in responses" help="Sign-in response types an app may use."
            value={@form[:dcr_allowed_response_types].value} choices={[{"code", "Authorization code"}]}
            errors={field_errors(@form_errors, :dcr_allowed_response_types)} />


          <Lockspire.Web.Components.AdminComponents.form_field
            id="dcr_allowed_redirect_uri_schemes"
            label="Allowed sign-in return URL schemes"
            help="For example, https. Each app's exact sign-in return URLs are set in its settings."
            errors={field_errors(@form_errors, :dcr_allowed_redirect_uri_schemes)}
          >
            <Lockspire.Web.Components.AdminComponents.multi_value_control
              id="dcr_allowed_redirect_uri_schemes"
              name="policy[dcr_allowed_redirect_uri_schemes]"
              value={@form[:dcr_allowed_redirect_uri_schemes].value}
              suggestions={["https", "http"]}
              errors={field_errors(@form_errors, :dcr_allowed_redirect_uri_schemes)}
            />
          </Lockspire.Web.Components.AdminComponents.form_field>

          <Lockspire.Web.Components.AdminComponents.form_field
            id="dcr_allowed_redirect_uri_hosts"
            label="Allowed sign-in return URL hosts"
            help="Hosts that apps may use in their sign-in return URLs."
            errors={field_errors(@form_errors, :dcr_allowed_redirect_uri_hosts)}
          >
            <Lockspire.Web.Components.AdminComponents.multi_value_control
              id="dcr_allowed_redirect_uri_hosts"
              name="policy[dcr_allowed_redirect_uri_hosts]"
              value={@form[:dcr_allowed_redirect_uri_hosts].value}
              suggestions={[]}
              errors={field_errors(@form_errors, :dcr_allowed_redirect_uri_hosts)}
            />
          </Lockspire.Web.Components.AdminComponents.form_field>
        </Lockspire.Web.Components.AdminComponents.workflow_shell>

        <Lockspire.Web.Components.AdminComponents.workflow_shell
          title="Expiry limits"
        >
          <p class="lockspire-admin-help">Lockspire enforces app, client secret and app management token expiry. Changing a lifetime only affects new or replaced items.</p>
          <Lockspire.Web.Components.AdminComponents.form_field
            id="dcr_default_client_lifetime_seconds"
            label="App lifetime (seconds)"
            help="How long a new app may use Lockspire."
            errors={field_errors(@form_errors, :dcr_default_client_lifetime_seconds)}
          >
            <:info label="About app lifetime">Lockspire stops an app from using OAuth when its expiry date is reached. This setting applies to new apps.</:info>
            <input
              type="number"
              min="0"
              max={PolicyForm.maximum_lifetime_seconds()}
              step="1"
              inputmode="numeric"
              id="dcr_default_client_lifetime_seconds"
              name="policy[dcr_default_client_lifetime_seconds]"
              value={@form[:dcr_default_client_lifetime_seconds].value}
              aria-invalid={if field_errors(@form_errors, :dcr_default_client_lifetime_seconds) != [], do: "true", else: "false"}
              aria-describedby={lifetime_described_by("dcr_default_client_lifetime_seconds", @form_errors)}
            />
            <p id="dcr_default_client_lifetime_seconds-duration" class="lockspire-admin-duration-hint" aria-live="polite">{LifetimeHint.describe(:dcr_default_client_lifetime_seconds, @form[:dcr_default_client_lifetime_seconds].value)}</p>
          </Lockspire.Web.Components.AdminComponents.form_field>

          <Lockspire.Web.Components.AdminComponents.form_field
            id="dcr_default_client_secret_lifetime_seconds"
            label="Client secret lifetime (seconds)"
            help="Sets how long shared secrets for new apps remain valid. Replacing a secret uses the current setting."
            errors={field_errors(@form_errors, :dcr_default_client_secret_lifetime_seconds)}
          >
            <:info label="About client secret lifetime">For example, 2592000 is 30 days. Leave blank or enter 0 for no automatic expiry. A positive value applies to new or replaced app secrets. Changing this setting does not change expiry on existing app secrets. Some older apps may have an advisory expiry date; replacing the secret sets its new expiry using the current setting.</:info>
            <input
              type="number"
              min="0"
              max={PolicyForm.maximum_lifetime_seconds()}
              step="1"
              inputmode="numeric"
              id="dcr_default_client_secret_lifetime_seconds"
              name="policy[dcr_default_client_secret_lifetime_seconds]"
              value={@form[:dcr_default_client_secret_lifetime_seconds].value}
              aria-invalid={if field_errors(@form_errors, :dcr_default_client_secret_lifetime_seconds) != [], do: "true", else: "false"}
              aria-describedby={lifetime_described_by("dcr_default_client_secret_lifetime_seconds", @form_errors)}
            />
            <p id="dcr_default_client_secret_lifetime_seconds-duration" class="lockspire-admin-duration-hint" aria-live="polite">{LifetimeHint.describe(:dcr_default_client_secret_lifetime_seconds, @form[:dcr_default_client_secret_lifetime_seconds].value)}</p>
          </Lockspire.Web.Components.AdminComponents.form_field>

          <Lockspire.Web.Components.AdminComponents.form_field
            id="dcr_default_registration_access_token_lifetime_seconds"
            label="App management token lifetime (seconds)"
            help="Leave blank or enter 0 for no automatic expiry. A positive duration applies to new or replaced app management tokens."
            errors={field_errors(@form_errors, :dcr_default_registration_access_token_lifetime_seconds)}
          >
            <:info label="About app management token lifetime">Changing this setting does not change existing app management tokens. Expiry blocks reading, updating or deleting an app registration until an authorized team member rotates the token. If an app loses access or a successful update response is lost, ask your provider team to rotate the token. Rotating the token does not renew the app or its client secret.</:info>
            <input
              type="number"
              min="0"
              max={PolicyForm.maximum_lifetime_seconds()}
              step="1"
              inputmode="numeric"
              id="dcr_default_registration_access_token_lifetime_seconds"
              name="policy[dcr_default_registration_access_token_lifetime_seconds]"
              value={@form[:dcr_default_registration_access_token_lifetime_seconds].value}
              aria-invalid={if field_errors(@form_errors, :dcr_default_registration_access_token_lifetime_seconds) != [], do: "true", else: "false"}
              aria-describedby={lifetime_described_by("dcr_default_registration_access_token_lifetime_seconds", @form_errors)}
            />
            <p id="dcr_default_registration_access_token_lifetime_seconds-duration" class="lockspire-admin-duration-hint" aria-live="polite">{LifetimeHint.describe(:dcr_default_registration_access_token_lifetime_seconds, @form[:dcr_default_registration_access_token_lifetime_seconds].value)}</p>
          </Lockspire.Web.Components.AdminComponents.form_field>
        </Lockspire.Web.Components.AdminComponents.workflow_shell>

        <Lockspire.Web.Components.AdminComponents.workflow_shell
          title="How apps authenticate"
        >
          <Lockspire.Web.Components.AdminComponents.checkbox_group
            id="dcr_allowed_token_endpoint_auth_methods" name="policy[dcr_allowed_token_endpoint_auth_methods]"
            label="Allowed authentication methods" help="How an app proves its identity when requesting tokens."
            value={@form[:dcr_allowed_token_endpoint_auth_methods].value} choices={[{"none", "No client secret"}, {"client_secret_basic", "Client secret in the request header"}, {"client_secret_post", "Client secret in the request body"}, {"client_secret_jwt", "Signed client assertion (JWT)"}, {"private_key_jwt", "Signed client assertion with app key"}]}
            errors={field_errors(@form_errors, :dcr_allowed_token_endpoint_auth_methods)} />
            <div class="lockspire-admin-jwt-guidance">
              <p class="lockspire-admin-help">
                <strong>Signed client assertion with app key (private_key_jwt):</strong> Apps sign assertions with a private key and provide a public key through <code>jwks</code> or <code>jwks_uri</code>. Supported signatures: <code>{Enum.join(@private_key_jwt_truth.supported_assertion_signing_algorithms, ", ")}</code>.
              </p>
              <p class="lockspire-admin-help">
                <strong>Signed client assertion (JWT) (client_secret_jwt):</strong>
                <%= if @client_secret_jwt_truth.fapi_effective? do %>
                  Unavailable while FAPI security requirements are active.
                <% else %>
                  Apps sign assertions with their shared secret using <code>{@client_secret_jwt_truth.signing_algorithm}</code>.
                <% end %>
              </p>
            </div>

        </Lockspire.Web.Components.AdminComponents.workflow_shell>

        <p class="lockspire-admin-help">These rules apply to new app registrations only. Existing apps and their credentials stay unchanged.</p>


        <Lockspire.Web.Components.AdminComponents.action_bar>
          <Lockspire.Web.Components.AdminComponents.admin_button
            type="submit"
            variant={:primary}
            phx-disable-with="Saving app registration settings…"
          >
            Save app registration settings
          </Lockspire.Web.Components.AdminComponents.admin_button>
        </Lockspire.Web.Components.AdminComponents.action_bar>
    </form>
  <% end %>
</Lockspire.Web.Live.AdminLayoutLive.shell>
