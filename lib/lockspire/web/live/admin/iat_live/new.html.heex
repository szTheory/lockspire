<Lockspire.Web.Live.AdminLayoutLive.shell current_section={@current_section} page_title={@page_title}>
  <Lockspire.Web.Components.AdminComponents.page_hero
    eyebrow="Configure"
    title="Create an Initial Access Token"
    body="Use this single-use token to authorize a partner's initial client registration request. Issuer DCR policy still controls which registrations are accepted."
  />

  <Lockspire.Web.Components.AdminComponents.workflow_shell
    title="Choose an expiry"
    help="This registration credential is not an OAuth access token and has no OAuth scopes."
  >
    <%= if @iat_secret do %>
      <Lockspire.Web.Components.AdminComponents.copy_once_secret_panel
        title="Copy this Initial Access Token now"
        body="This single-use token authorizes one initial client registration request under issuer DCR policy. Its plaintext is shown only here."
        label="Initial Access Token"
        value={@iat_secret}
      />
      <Lockspire.Web.Components.AdminComponents.action_bar>
        <Lockspire.Web.Components.AdminComponents.admin_button
          phx-click="acknowledge_copy"
          variant={:secondary}
        >
          Hide credential
        </Lockspire.Web.Components.AdminComponents.admin_button>
      </Lockspire.Web.Components.AdminComponents.action_bar>
    <% else %>
      <p :if={@iat_acknowledged?} role="status" aria-live="polite">
        Credential hidden. It will not be shown again.
      </p>
      <Lockspire.Web.Components.AdminComponents.error_summary
        title="Review Initial Access Token details"
        errors={@form_errors}
      />

      <form id="iat_mint_form" phx-submit="mint" class="lockspire-admin-form-stack">
        <Lockspire.Web.Components.AdminComponents.form_field
          id="iat_expires_in_days"
          label="Expires in days"
          help="This token expires after the number of days you enter. Issuer DCR policy still applies."
          required
          errors={if(@expiry_error, do: [%{message: @expiry_error}], else: [])}
        >
          <input
            id="iat_expires_in_days"
            type="number"
            name="expires_in_days"
            value={@form["expires_in_days"].value || ""}
            required
            min="1"
            aria-invalid={if(@expiry_error, do: "true", else: nil)}
            aria-describedby={expiry_describedby(@expiry_error)}
          />
        </Lockspire.Web.Components.AdminComponents.form_field>

        <Lockspire.Web.Components.AdminComponents.action_bar>
          <Lockspire.Web.Components.AdminComponents.admin_button
            variant={:primary}
            type="submit"
            phx-disable-with="Creating Initial Access Token…"
          >
            Create an Initial Access Token
          </Lockspire.Web.Components.AdminComponents.admin_button>
          <Lockspire.Web.Components.AdminComponents.admin_button
            href={iat_index_path()}
            variant={:secondary}
          >
            Review Initial Access Tokens
          </Lockspire.Web.Components.AdminComponents.admin_button>
        </Lockspire.Web.Components.AdminComponents.action_bar>
      </form>
    <% end %>
  </Lockspire.Web.Components.AdminComponents.workflow_shell>
</Lockspire.Web.Live.AdminLayoutLive.shell>
