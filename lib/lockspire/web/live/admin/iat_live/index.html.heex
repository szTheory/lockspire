<Lockspire.Web.Live.AdminLayoutLive.shell current_section={@current_section} page_title={@page_title}>
  <Lockspire.Web.Components.AdminComponents.page_hero
    eyebrow="Configure"
    title="Initial Access Token inventory"
    body="Review each token's status, expiry, creator, and use limit. Token values are never shown in this inventory."
  />

  <Lockspire.Web.Components.AdminComponents.pane
    title="Review Initial Access Tokens"
    subtitle="An Initial Access Token authorizes initial client registration under issuer DCR policy. It is not an OAuth access token, has no OAuth scopes, and cannot manage an existing client."
  >
    <p :if={@revoke_notice} class="lockspire-admin-help" role="status" aria-live="polite">
      {@revoke_notice}
    </p>

    <Lockspire.Web.Components.AdminComponents.alert
      :if={@revoke_error}
      variant={:warning}
      title="Revocation not confirmed"
      role="alert"
    >
      {@revoke_error}
    </Lockspire.Web.Components.AdminComponents.alert>

    <%= if @inventory_state == :loading do %>
      <p class="lockspire-admin-help" role="status" aria-live="polite">
        Loading Initial Access Token inventory…
      </p>
    <% end %>

    <%= if @inventory_state == :unavailable do %>
      <Lockspire.Web.Components.AdminComponents.alert
        variant={:danger}
        title="Initial Access Token inventory unavailable"
        role="alert"
      >
        {@inventory_error}
      </Lockspire.Web.Components.AdminComponents.alert>

      <Lockspire.Web.Components.AdminComponents.action_bar>
        <Lockspire.Web.Components.AdminComponents.admin_button
          type="button"
          variant={:primary}
          phx-click="reload_iats"
          phx-disable-with="Reloading inventory…"
        >
          Reload inventory
        </Lockspire.Web.Components.AdminComponents.admin_button>
        <Lockspire.Web.Components.AdminComponents.admin_button href={iat_new_path()}>
          Create an Initial Access Token
        </Lockspire.Web.Components.AdminComponents.admin_button>
      </Lockspire.Web.Components.AdminComponents.action_bar>
    <% end %>

    <%= if @inventory_state == :loaded do %>
      <Lockspire.Web.Components.AdminComponents.metric_grid>
        <Lockspire.Web.Components.AdminComponents.summary_stat
          value={@inventory_counts.active}
          label="Active"
        />
        <Lockspire.Web.Components.AdminComponents.summary_stat
          value={@inventory_counts.used}
          label="Used"
        />
        <Lockspire.Web.Components.AdminComponents.summary_stat
          value={@inventory_counts.expired}
          label="Expired"
        />
        <Lockspire.Web.Components.AdminComponents.summary_stat
          value={@inventory_counts.revoked}
          label="Revoked"
        />
        <Lockspire.Web.Components.AdminComponents.summary_stat
          value={@inventory_counts.total}
          label="Total tokens"
        />
      </Lockspire.Web.Components.AdminComponents.metric_grid>

      <%= if @tokens == [] do %>
        <Lockspire.Web.Components.AdminComponents.empty_state
          title="No Initial Access Tokens yet"
          body="Create a single-use Initial Access Token for a partner's first registration request. Issuer DCR policy still applies."
        >
          <:actions>
            <Lockspire.Web.Components.AdminComponents.admin_button href={iat_new_path()} variant={:primary}>
              Create an Initial Access Token
            </Lockspire.Web.Components.AdminComponents.admin_button>
          </:actions>
        </Lockspire.Web.Components.AdminComponents.empty_state>
      <% else %>
        <Lockspire.Web.Components.AdminComponents.action_bar>
          <Lockspire.Web.Components.AdminComponents.admin_button href={iat_new_path()} variant={:primary}>
          Create an Initial Access Token
          </Lockspire.Web.Components.AdminComponents.admin_button>
          <Lockspire.Web.Components.AdminComponents.admin_button
            type="button"
            phx-click="reload_iats"
            phx-disable-with="Reloading inventory…"
          >
            Reload inventory
          </Lockspire.Web.Components.AdminComponents.admin_button>
        </Lockspire.Web.Components.AdminComponents.action_bar>

        <Lockspire.Web.Components.AdminComponents.resource_list>
          <%= for token <- @tokens do %>
            <Lockspire.Web.Components.AdminComponents.dense_resource_row
              title={token_title(token)}
              subtitle="Authorizes initial client registration under issuer DCR policy"
            >
              <:meta>
                <span>
                  Created by
                  <Lockspire.Web.Components.AdminComponents.long_value
                    value={token.created_by || "Not recorded"}
                    kind={:id}
                  />
                </span>
                <span>
                  Expires
                  <Lockspire.Web.Components.AdminComponents.long_value
                    value={formatted_timestamp(token.expires_at)}
                    kind={:timestamp}
                  />
                </span>
                <span>
                  Last state change
                  <Lockspire.Web.Components.AdminComponents.long_value
                    value={formatted_timestamp(token_timestamp(token))}
                    kind={:timestamp}
                  />
                </span>
                <span>
                  Use limit
                  <Lockspire.Web.Components.AdminComponents.long_value
                    value={usage_label(token)}
                    kind={:text}
                  />
                </span>
              </:meta>
              <:status>
                <Lockspire.Web.Components.AdminComponents.status_badge status={iat_status(token)} />
              </:status>
              <:actions>
                <%= if iat_status(token) == :active do %>
                  <Lockspire.Web.Components.AdminComponents.confirmation_panel
                    title="Revoke Initial Access Token"
                    variant={:danger}
                    errors={iat_revoke_error(@revoke_error)}
                  >
                    <:body>
                      <form class="lockspire-admin-form-stack" phx-submit="confirm_revoke_iat">
                        <input type="hidden" name="revoke[id]" value={token.id} />
                        <label
                          class="lockspire-admin-checkbox-field"
                          for={"revoke_iat_#{token.id}_confirm"}
                        >
                          <input
                            id={"revoke_iat_#{token.id}_confirm"}
                            type="checkbox"
                            name="revoke[confirm]"
                            value="true"
                          />
                          <span>
                            {iat_revoke_confirmation_copy(token)}
                          </span>
                        </label>
                        <Lockspire.Web.Components.AdminComponents.action_bar>
                          <Lockspire.Web.Components.AdminComponents.admin_button
                            type="submit"
                            variant={:danger}
                            phx-disable-with="Revoking Initial Access Token…"
                          >
                            Revoke Initial Access Token
                          </Lockspire.Web.Components.AdminComponents.admin_button>
                        </Lockspire.Web.Components.AdminComponents.action_bar>
                      </form>
                    </:body>
                  </Lockspire.Web.Components.AdminComponents.confirmation_panel>
                <% end %>
              </:actions>
            </Lockspire.Web.Components.AdminComponents.dense_resource_row>
          <% end %>
        </Lockspire.Web.Components.AdminComponents.resource_list>
      <% end %>
    <% end %>
  </Lockspire.Web.Components.AdminComponents.pane>
</Lockspire.Web.Live.AdminLayoutLive.shell>
