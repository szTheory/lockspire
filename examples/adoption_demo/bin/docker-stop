#!/usr/bin/env sh
set -eu

usage() {
  cat <<'USAGE'
Usage: examples/adoption_demo/bin/docker-stop [--project NAME]

Stop the active adoption demo Docker project and preserve volumes.

The default project is COMPOSE_PROJECT_NAME, or lockspire-adoption-demo when
COMPOSE_PROJECT_NAME is not set. Pass --project NAME to match docker compose
--project-name NAME / -p NAME startup.

This command runs docker compose down without deleting project volumes.
USAGE
}

project="${COMPOSE_PROJECT_NAME:-lockspire-adoption-demo}"

while [ "$#" -gt 0 ]; do
  case "$1" in
    --project)
      if [ "$#" -lt 2 ]; then
        echo "Missing value for --project" >&2
        usage >&2
        exit 1
      fi
      project="$2"
      shift 2
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *)
      echo "Unknown argument: $1" >&2
      usage >&2
      exit 1
      ;;
  esac
done

if ! command -v git >/dev/null 2>&1; then
  echo "git is required to locate the Lockspire repo root" >&2
  exit 1
fi

if ! command -v docker >/dev/null 2>&1; then
  echo "docker is required to stop the adoption demo" >&2
  exit 1
fi

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

docker compose --project-name "$project" -f examples/adoption_demo/docker-compose.yml down

echo "Stopped adoption demo Docker project ${project}; volumes were preserved."
