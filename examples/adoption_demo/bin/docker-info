#!/usr/bin/env sh
set -eu

BASE_URL="${LOCKSPIRE_DEMO_BASE_URL:-http://lockspire-demo.localhost}"
BASE_URL="$(printf '%s' "$BASE_URL" | sed 's:/*$::')"
PROJECT="${COMPOSE_PROJECT_NAME:-lockspire-adoption-demo}"

if [ "$PROJECT" = "lockspire-adoption-demo" ]; then
  MAKE_PREFIX=""
else
  MAKE_PREFIX="COMPOSE_PROJECT_NAME=${PROJECT} "
fi

COMPOSE_CMD="docker compose --project-name ${PROJECT} -f examples/adoption_demo/docker-compose.yml"

cat <<INFO
Billingo + Lockspire demo
Adoption demo ready at ${BASE_URL}

Ready
  Operator admin: ${BASE_URL}/lockspire/admin
  Login: ops (choose it if prompted)

Next
  Smoke: ${MAKE_PREFIX}make demo-smoke
  Info: ${MAKE_PREFIX}make demo-info
  Logs: ${MAKE_PREFIX}make demo-logs
  Stop: ${MAKE_PREFIX}make demo-stop

Details
  Base URL: ${BASE_URL}
  Admin: ${BASE_URL}/lockspire/admin
  Developer apps: ${BASE_URL}/developer/apps
  Device verification: ${BASE_URL}/verify
  Issuer: ${BASE_URL}/lockspire
  Discovery: ${BASE_URL}/lockspire/.well-known/openid-configuration
  JWKS: ${BASE_URL}/lockspire/jwks
  OAuth callback: ${BASE_URL}/oauth/callback
  Protected API: ${BASE_URL}/api/billing/summary

Seeded accounts
  alice | alice@billingo.test | Billingo | developer account
  bob   | bob@northstar.test | Northstar Retail | developer account
  ops   | ops@billingo.test | Billingo | operator account

Seeded OAuth clients
  billingo-dashboard-public | public | grants: authorization_code,refresh_token | auth: none | PKCE required
  billingo-display-device | public | grants: device_code | auth: none | PKCE required
  billingo-reports-backend | confidential | grants: authorization_code,refresh_token | auth: client_secret_basic | PKCE required
  northstar-payables-portal | confidential self-registered | grants: authorization_code,refresh_token | auth: client_secret_basic | PKCE required | PAR required | DPoP required
  legacy-csv-reporter | disabled confidential | grants: authorization_code,refresh_token | auth: client_secret_basic | PKCE required

Smoke command
  LOCKSPIRE_DEMO_BASE_URL=${BASE_URL} scripts/demo/adoption_smoke.sh

Launcher
  ${MAKE_PREFIX}make demo
  ${MAKE_PREFIX}make demo-smoke
  ${MAKE_PREFIX}make demo-stop
  scripts/demo/admin-ui --project ${PROJECT} up
  scripts/demo/admin-ui --project ${PROJECT} smoke
  scripts/demo/admin-ui --project ${PROJECT} logs
  scripts/demo/admin-ui --project ${PROJECT} stop
  examples/adoption_demo/bin/docker-up
  examples/adoption_demo/bin/docker-up --direct

Reprint:
  ${COMPOSE_CMD} exec web ./bin/docker-info
INFO
