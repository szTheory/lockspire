FROM hexpm/elixir:1.18.4-erlang-28.5-ubuntu-noble-20260509.1

# Install essential build tools and readiness utilities for Phoenix live-reload.
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      build-essential \
      ca-certificates \
      curl \
      git \
      inotify-tools \
      npm \
      postgresql-client && \
    rm -rf /var/lib/apt/lists/*

# Set working directory inside the repo-root mount.
WORKDIR /workspace/examples/adoption_demo

# Install Hex and Rebar globally
RUN mix local.hex --force && \
    mix local.rebar --force

# We intentionally DO NOT copy source code or run deps.get here.
# Source code is volume-mounted to allow instant live-reloading.
# deps and _build are isolated in anonymous volumes to persist between restarts.

CMD ["sh", "-c", "mix deps.get && mix phx.server"]
